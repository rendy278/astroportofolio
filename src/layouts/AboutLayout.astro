---
import Layout from './Layout.astro'

const lang = Astro.props?.lang ?? 'id'
const title = Astro.props?.title ?? (lang === 'en' ? 'About — Rendev Studio' : 'Tentang — Rendev Studio')
const description = Astro.props?.description ?? (lang === 'en' ? 'About Rendev Studio' : 'Tentang Rendev Studio')

---

<Layout lang={lang} title={title} description={description} ogTitle={title} ogDescription={description}>
  <div slot="head">
    
  </div>

  <main class="w-full">
    <slot />
  </main>
</Layout>
