---
import '../../../../public/global.css'
export const prerender = true
import LogoWebLoad from '../../public/logo.png'

// bahasa default kalau JS mati / crawler yang tidak eksekusi JS
const fallbackTo = '/id/'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirecting...</title>

    <!-- Jangan sampai halaman redirect ini yang ke-index, biar target (/id/ atau /en/) yang diindeks -->
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={fallbackTo} />

    <!-- Fallback untuk browser tanpa JS / crawler lama, kasih delay biar script JS sempat jalan duluan -->
    <meta http-equiv="refresh" content={`2; url=${fallbackTo}`} />

    <style>
      @keyframes spin { to { transform: rotate(360deg); } }
      @keyframes pulse-logo {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(1.06); opacity: 0.85; }
      }
      @keyframes bounce-dot {
        0%, 80%, 100% { transform: translateY(0); }
        40% { transform: translateY(-6px); }
      }
    </style>
  </head>
  <body class="m-0 min-h-screen flex items-center justify-center bg-gradient-to-br from-sky-500 via-sky-400 to-yellow-500">
    <main class="flex flex-col items-center gap-6 px-6 text-center">
      <div class="relative flex items-center justify-center w-28 h-28">
        <span class="absolute inset-0 rounded-full border-4 border-white/30"></span>
        <span
          class="absolute inset-0 rounded-full border-4 border-t-yellow-300 border-r-transparent border-b-transparent border-l-transparent"
          style="animation: spin 1s linear infinite;"
        ></span>
        <img
          src={LogoWebLoad.src}
          alt="Logo"
          width="64"
          height="64"
          class="relative z-10 rounded-full bg-white p-2 shadow-lg"
          style="animation: pulse-logo 1.6s ease-in-out infinite;"
        />
      </div>

      <div class="space-y-2">
        <p class="text-white font-semibold text-lg tracking-wide inline-flex items-center">
          Redirecting
          <span class="inline-flex ml-1">
            <span class="w-1.5 h-1.5 mx-0.5 bg-white rounded-full" style="animation: bounce-dot 1.4s infinite ease-in-out; animation-delay: 0s;"></span>
            <span class="w-1.5 h-1.5 mx-0.5 bg-white rounded-full" style="animation: bounce-dot 1.4s infinite ease-in-out; animation-delay: 0.2s;"></span>
            <span class="w-1.5 h-1.5 mx-0.5 bg-white rounded-full" style="animation: bounce-dot 1.4s infinite ease-in-out; animation-delay: 0.4s;"></span>
          </span>
        </p>
        <p class="text-white/80 text-sm">Jika tidak otomatis teralihkan, silakan pilih bahasa:</p>
        <div class="flex gap-3 justify-center mt-2">
          <a href="/id/" class="px-4 py-1.5 rounded-full bg-white/90 text-sky-600 font-medium text-sm hover:bg-white transition">
            Bahasa Indonesia
          </a>
          <a href="/en/" class="px-4 py-1.5 rounded-full bg-white/90 text-yellow-600 font-medium text-sm hover:bg-white transition">
            English
          </a>
        </div>
      </div>
    </main>

    <script is:inline>
      (function () {
        try {
          var lang = (navigator.language || navigator.userLanguage || 'id').toLowerCase()
          var target = lang.startsWith('id') ? '/id/' : '/en/'
          window.location.replace(target)
        } catch (e) {
          window.location.href = '/id/'
        }
      })()
    </script>
  </body>
</html>